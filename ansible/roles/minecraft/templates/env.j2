# {{ ansible_managed }}
# Minecraft Server Environment Configuration

# Server Settings
MINECRAFT_VERSION={{ minecraft_version }}
SERVER_NAME={{ minecraft_server_name }}
MINECRAFT_PORT={{ minecraft_port }}
MEMORY={{ minecraft_memory }}

# RCON Configuration
RCON_ENABLED={{ minecraft_rcon_enabled | string | lower }}
RCON_PASSWORD={{ minecraft_rcon_password }}
RCON_PORT={{ minecraft_rcon_port }}

# Backup Configuration
{% if minecraft_backup_enabled %}
BACKUP_ENABLED=true
S3_ENDPOINT={{ minecraft_backup_s3_endpoint }}
S3_BUCKET={{ minecraft_backup_s3_bucket }}
S3_ACCESS_KEY={{ minecraft_backup_s3_access_key }}
S3_SECRET_KEY={{ minecraft_backup_s3_secret_key }}
RESTIC_PASSWORD={{ minecraft_backup_restic_password }}
{% else %}
BACKUP_ENABLED=false
{% endif %}

# Prometheus Configuration
{% if minecraft_prometheus_enabled %}
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT={{ minecraft_prometheus_port }}
{% else %}
PROMETHEUS_ENABLED=false
{% endif %}

# Packwiz Configuration
{% if minecraft_packwiz_enabled %}
PACKWIZ_ENABLED=true
PACKWIZ_PORT={{ minecraft_packwiz_port }}
{% else %}
PACKWIZ_ENABLED=false
{% endif %}

# Infrared (Scale-to-zero) Configuration
{% if minecraft_infrared_enabled %}
INFRARED_ENABLED=true
AUTOSTOP_TIMEOUT={{ minecraft_autostop_timeout }}
{% else %}
INFRARED_ENABLED=false
{% endif %}

# Data Paths
DATA_DIR={{ minecraft_data_dir }}
INSTALL_DIR={{ minecraft_install_dir }}
