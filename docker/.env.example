# Minecraft Server Environment Configuration
# Copier vers .env et personnaliser

# === Version Minecraft ===
MC_VERSION=1.21.1
MC_MEMORY=6G

# === Serveur ===
SERVER_NAME=Mon Serveur Minecraft
MOTD=§6Bienvenue! §7Serveur géré automatiquement
DIFFICULTY=normal
GAMEMODE=survival
MAX_PLAYERS=20
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8

# === Sécurité ===
ONLINE_MODE=true
ENABLE_WHITELIST=true
# OPS=pseudo1,pseudo2
# WHITELIST=pseudo1,pseudo2,pseudo3

# === RCON (générer un password fort!) ===
RCON_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Auto-stop (secondes sans joueur) ===
AUTOSTOP_TIMEOUT=3600  # 1 heure

# === Plugins (IDs Spiget, séparés par virgule) ===
# Spark: 57242, CoreProtect: 8631, LuckPerms: 28140
# SPIGET_RESOURCES=57242,8631,28140

# === Backup S3 ===
S3_ENDPOINT=s3.fr-par.scw.cloud
S3_BUCKET=minecraft-backups
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
RESTIC_PASSWORD=CHANGE_ME_BACKUP_PASSWORD

# === Chemins ===
DATA_PATH=/opt/minecraft/data

# === Domaine (pour Traefik) ===
DOMAIN=example.com
